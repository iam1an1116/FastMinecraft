{
  "name": "FastMinecraft",
  "version": "1.0.0-beta2",
  "private": true,
  "main": "main.js",
  "productName": "FastMinecraft",
  "description": "一键创建和管理 Minecraft 服务器",
  "author": "1an",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win"
  },
  "dependencies": {
    "electron-is-dev": "^2.0.0",
    "express": "^4.18.2",
    "sql.js": "^1.10.0",
    "ws": "^8.16.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0",
    "adm-zip": "^0.5.10",
    "cron": "^3.1.6",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "electron": "28.3.3",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.fastminecraft.app",
    "productName": "FastMinecraft",
    "files": [
      "main.js",
      "preload.js",
      "icon.png",
      "backend/**",
      "frontend/dist/**"
    ],
    "directories": {
      "output": "/Users/1an/Desktop/FastMinecraft-Releases"
    },
    "asar": true,
    "mac": {
      "target": "dmg",
      "icon": "icon.icns",
      "artifactName": "mac/FastMinecraft-${version}-mac-arm64.${ext}"
    },
    "win": {
      "target": "zip",
      "icon": "icon.png",
      "signAndEditExecutable": false,
      "artifactName": "windows/FastMinecraft-${version}-win-x64.${ext}"
    }
  }
}
